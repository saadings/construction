# Convex — written by `npx convex dev`
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# Clerk
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Read by Convex from the deployment's own environment, not from this file.
# Setting it only here leaves every signed-in person refused by the backend
# while signing in still looks like it worked. CI sets it on the deployment;
# by hand it goes on the deployment too, under this same name.
CLERK_FRONTEND_API_URL=

# Cloudflare — deploys run in CI, these are for local inspection only
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
