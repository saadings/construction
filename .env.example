# Convex — written by `npx convex dev`
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# Clerk
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Read by Convex from the deployment's own environment, not from this file.
# Setting them only here leaves the backend without them while the browser
# carries on looking normal: no issuer refuses every signed-in person, and no
# webhook secret makes the sign-up webhook answer 500, so the users table stays
# empty behind a completed sign-up. CI sets both on the deployment; by hand
# they go on the deployment too, under these same names.
CLERK_FRONTEND_API_URL=
CLERK_WEBHOOK_SECRET=

# Cloudflare — deploys run in CI, these are for local inspection only
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
