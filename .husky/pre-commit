# Only the already-staged paths are re-staged after the fixers: a bare `git add -u` sweeps in every other modified file.
staged=$(git diff --cached --name-only --diff-filter=ACMR)

# The worktree is set to the index first, so re-adding cannot sweep back a hunk that `git add -p` deliberately left out.
stashed=no
if ! git diff --quiet; then
  git stash push --keep-index --quiet --message 'pre-commit: unstaged work'
  stashed=$(git rev-parse stash@{0})
fi

restore() {
  if [ "$stashed" = no ]; then
    return 0
  fi

  # Back as a patch, not `git stash pop`: a three-way merge conflicts on exactly the accepted-and-declined-hunk case this exists for.
  if git diff --binary --unified=0 "$stashed^2" "$stashed" |
    git apply --unidiff-zero --whitespace=nowarn -; then
    git stash drop --quiet
    return 0
  fi

  # Never half-done: a patch that will not apply leaves the stash alone, which is the only copy of that work.
  echo "The unstaged work could not be put back automatically."
  echo "It is safe in the most recent stash entry: git stash list"
  exit 1
}
trap restore EXIT

yarn lint:fix
yarn format:fix

if [ -n "$staged" ]; then
  printf '%s\n' "$staged" | tr '\n' '\0' | xargs -0 git add --
fi

# Refreshes convex/_generated when a deployment is linked; not having one is no reason to refuse a commit, since CI generates its own.
npx convex codegen --typecheck disable || echo "Left the generated Convex types as they are."

yarn typecheck
yarn build
yarn test
yarn test:scenario
