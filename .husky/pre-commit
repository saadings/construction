# Only the already-staged paths are re-staged after the fixers: a bare `git add -u` sweeps in every other modified file.
staged=$(git diff --cached --name-only --diff-filter=ACMR)

# The checks run against a throwaway checkout of the index rather than against this tree, which is never stashed or modified.
gate=$(mktemp -d)
# shellcheck disable=SC2064
trap "rm -rf '$gate'" EXIT

git checkout-index -a -f --prefix="$gate/"

# None of these are in the index — installed, generated, and deliberately never committed — and the checks below need all three.
ln -s "$PWD/node_modules" "$gate/node_modules"
if [ -d convex/_generated ]; then
  mkdir -p "$gate/convex"
  ln -s "$PWD/convex/_generated" "$gate/convex/_generated"
fi
# Linked rather than copied, so no secret is ever written to a second place on disk.
if [ -f .env.local ]; then
  ln -s "$PWD/.env.local" "$gate/.env.local"
fi

(cd "$gate" && yarn lint:fix && yarn format:fix)

# Fixer output returns to the index always, and to the worktree only where it already matched, so nothing unstaged is lost.
for path in $staged; do
  [ -f "$gate/$path" ] || continue

  mode=$(git ls-files --stage -- "$path" | cut -d' ' -f1)
  [ -n "$mode" ] || continue

  blob=$(git hash-object -w -- "$gate/$path")
  [ "$blob" = "$(git rev-parse ":$path")" ] && continue

  if git diff --quiet -- "$path"; then
    cp "$gate/$path" "$path"
  fi
  git update-index --cacheinfo "$mode,$blob,$path"
done

# Refreshes convex/_generated when a deployment is linked; not having one is no reason to refuse a commit, since CI generates its own.

# It must say so loudly when it cannot, because stale generated types make `ctx.db` an `any` and the typecheck below then passes while checking nothing.
npx convex codegen --typecheck disable || {
  echo ""
  echo "  !!  COULD NOT REGENERATE convex/_generated  !!"
  echo ""
  echo "  The generated Convex types are whatever they were before this commit."
  echo "  If a table or function changed since they were written, everything below"
  echo "  this line is checking the wrong types: db reads come back as 'any', so a"
  echo "  green typecheck here proves nothing and a red one may not be your fault."
  echo ""
  echo "  Trust CI over this run until 'npx convex codegen' succeeds locally."
  echo ""
}

(cd "$gate" && yarn typecheck && yarn build && yarn test)

# Run here rather than in the throwaway: this suite's subject is the repository itself, and reads git history and the index directly.
yarn test:scenario
